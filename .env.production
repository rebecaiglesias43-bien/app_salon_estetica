# ============================================================
# 🚀 PRODUCCIÓN — Configuración para Render + Aiven MySQL
# ============================================================
# Copia esto al dashboard de Render como Environment Variables,
# NO subas este archivo al repo con valores reales.
# ============================================================

# ── Base de datos (Aiven MySQL) ──
# Después de crear tu instancia en Aiven, reemplaza estos valores:
DB_HOST=tu-instancia.aivencloud.com
DB_PORT=3306
DB_USER=avnadmin
DB_PASSWORD=tu-contraseña-de-aiven
DB_NAME=sistema_estetica

# ── SSL / TLS para Aiven ──
# Copia el contenido del certificado CA que Aiven te proporciona
# (incluyendo las lineas -----BEGIN CERTIFICATE----- y -----END CERTIFICATE-----)
# y pégalo completo como valor de esta variable en el dashboard de Render.
# El backend lo escribe a /tmp/aiven-ca.pem automaticamente al arrancar.
DB_SSL_CA=-----BEGIN CERTIFICATE-----
...pega aqui el contenido completo del certificado CA de Aiven...
-----END CERTIFICATE-----

# ── Seguridad ──
# Genera una clave segura: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia_esto_por_una_clave_segura_aleatoria
JWT_ACCESS_TOKEN_EXPIRES=3600

# ── CORS ──
# La URL de tu frontend en Vercel (sin slash al final)
CORS_ORIGINS=https://tu-frontend.vercel.app

# ── Flask ──
FLASK_ENV=production
